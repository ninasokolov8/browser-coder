{
  "name": "browser-coder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:browser && npm run test:contract",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\" \"tests/unit/**/*.test.ts\"",
    "test:contract": "node --test --test-concurrency=1 --test-timeout=300000 \"tests/contract/*.test.mjs\"",
    "test:legacy": "cd tests && bash run-tests.sh all",
    "test:security": "cd tests && bash run-tests.sh security",
    "test:browser": "node tests/browser/run.mjs workspace && node tests/browser/run.mjs app-boot",
    "test:browser:workspace": "node tests/browser/run.mjs workspace",
    "test:browser:app": "node tests/browser/run.mjs app-boot"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.0",
    "vite": "^5.4.8"
  }
}
