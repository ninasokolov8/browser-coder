# Dependencies
node_modules/

MeadowPy-main

# Build output
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Docker volumes (local)
data/

# Generated security reports (keep only latest)
tests/reports/*security-report*
!tests/reports/security-report-latest.html
!tests/reports/security-report-latest.json
!tests/reports/security-report-latest-he.html
!tests/reports/index.html

# Security module reports (all reports are generated, not tracked)
security/reports/*
!security/reports/.gitkeep
!security/reports/index.html

# Test-suite reports. Regenerated by every security run, so tracking them meant
# a 17,000-line diff attached to any commit that happened to run the suite -
# which buries the actual change. index.html is the browsable entry point and is
# hand-written, so it stays.
tests/reports/*
!tests/reports/index.html
!tests/reports/.gitkeep
