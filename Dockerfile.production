# Production Dockerfile - Auto-scaling ready for 10k+ users
# SECURITY HARDENED: Sandboxed code execution environment

FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Limit Node memory during build to prevent OOM on small servers (1GB is minimum for Vite)
RUN NODE_OPTIONS="--max-old-space-size=1024" npm run build

# Production runtime
FROM node:20-alpine

# Install language runtimes
# su-exec: lets the entrypoint start as root (to fix bind-mounted volume
# permissions) and then drop down to the unprivileged "app" user
# php-pecl-xdebug: the PHP debugger. Deliberately NOT enabled in php.ini - an
# ordinary run must not pay for a debugger it is not using - so the debug adapter
# loads it per process with -dzend_extension=xdebug and nothing else ever sees it.
RUN apk add --no-cache python3 openjdk17-jdk php php-pecl-xdebug bash dotnet8-sdk su-exec curl && rm -rf /var/cache/apk/*

# The C# debugger.
#
# netcoredbg, the obvious choice, BUILDS on Alpine and then segfaults the moment it
# launches a program: on musl CoreCLR's PAL probes the stack with _alloca(1.5 MB) from
# a thread whose stack is exactly 1.5 MB (dotnet/runtime#103741, Samsung/netcoredbg#206,
# both open, and no linker stack flag can fix it because the probe size and the thread
# size are the same constant). dncdbg is the netcoredbg maintainer's own fork with that
# fixed, and the only .NET debugger publishing a linux-musl-x64 build. Section 49.
#
# Pinned by version deliberately: a debugger that changes under a running deployment
# is a debugger nobody can reason about.
ARG DNCDBG_VERSION=1.1.0
RUN mkdir -p /opt/stage && \
    curl -sSL "https://github.com/viewizard/dncdbg/releases/download/v${DNCDBG_VERSION}/dncdbg-${DNCDBG_VERSION}-linux-musl-x64.tar.gz" \
      | tar -xz -C /opt/stage 2>/dev/null; \
    mv /opt/stage/dncdbg /opt/dncdbg && rm -rf /opt/stage /opt/dncdbg/._* && \
    # The upstream tarball is built on macOS, so every entry arrives owned by uid 501
    # and group "dialout". It happens to work, because the modes are 755/644 - but a
    # debugger owned by an arbitrary uid is one `umask` change away from not working,
    # and nothing else in this image is owned by a stranger.
    chown -R root:root /opt/dncdbg && \
    chmod 755 /opt/dncdbg/dncdbg && chmod 644 /opt/dncdbg/libdbgshim.so && \
    /opt/dncdbg/dncdbg --version

# .NET environment
ENV DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_GENERATE_ASPNET_CERTIFICATE=false

# SECURITY: Create non-root user with minimal permissions
RUN addgroup -g 1001 -S app && \
    adduser -u 1001 -S app -G app -h /home/app -s /sbin/nologin

# SECURITY: Create isolated temp directory for code execution
RUN mkdir -p /app/sandbox && chown app:app /app/sandbox && chmod 700 /app/sandbox

WORKDIR /app

# Production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy built app
#
# This list is an allowlist, which is the right default for a production image -
# but it means a new top-level source directory must be added here or the image
# silently ships without it. The refactor's `server/` tree is exactly that case:
# omitting it produced ERR_MODULE_NOT_FOUND for server/config.mjs at startup,
# with a healthy-looking build and a container that could not boot.
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/server.mjs ./
COPY --from=builder /app/server ./server
COPY --from=builder /app/languages ./languages
COPY --from=builder /app/security ./security
COPY --from=builder /app/tests ./tests

# Fail the BUILD rather than the container if a required module is missing.
# A missing import is otherwise only discovered when the process starts, which in
# a rolling deploy means the old container is already gone.
RUN node --input-type=module -e "import('/app/server/config.mjs').then(()=>console.log('module tree present'))"

# Ensure reports directories exist and are writable
RUN mkdir -p /app/security/reports /app/tests/reports /preview-data && \
    chown app:app /preview-data && chmod 770 /preview-data

# SECURITY: Set proper ownership and permissions
RUN chown -R app:app /app && \
    chmod -R 755 /app && \
    chmod 644 /app/server.mjs && \
    find /app/languages -type d -exec chmod 755 {} \; && \
    find /app/languages -type f -exec chmod 444 {} \; && \
    chmod 777 /app/tests/reports && \
    chmod 777 /app/security/reports

# SECURITY: Remove unnecessary packages and shells after setup
RUN rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh

# NOTE: intentionally NOT switching to `USER app` here. The container starts
# as root so the entrypoint can repair permissions on bind-mounted volumes
# (security/reports, tests/reports) which may be owned by whatever UID
# checked out the repo on the host - then it drops to the unprivileged
# "app" user (via su-exec) before running the actual server process.

# SECURITY: Restrict environment
ENV NODE_ENV=production \
    PORT=3001 \
    HOME=/home/app \
    TMPDIR=/app/sandbox

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3001/health || exit 1

EXPOSE 3001
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "server.mjs"]
