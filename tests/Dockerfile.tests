# Dockerfile for running tests against the Browser Coder API
FROM node:22-alpine

WORKDIR /app

# Install dependencies for testing
RUN apk add --no-cache curl bash jq

# Copy package files
COPY package*.json ./
RUN npm ci --omit=dev

# Copy security module (new modular structure)
COPY security/ ./security/

# The report runner imports only the canonical attack fixtures.
COPY tests/security/attacks/ ./tests/security/attacks/

# Default command runs security tests
CMD ["node", "security/run.mjs", "--server=http://api:3001"]
